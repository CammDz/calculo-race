# Variables públicas (frontend Cloudflare Pages / Vite)
# Copia este archivo a .env y completa los valores desde Supabase > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...tu-anon-key-ficticia
# Ambas variables son OBLIGATORIAS. Sin ellas la app muestra
# "Servicio no disponible" en lugar de funcionar.

# Variables privadas SOLO para Supabase Edge Functions / servidor (nunca en Cloudflare Pages frontend):
# Configúralas con: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... etc.
# SUPABASE_SERVICE_ROLE_KEY=(solo en servidor, jamás en el frontend)
# SUPABASE_URL=(se inyecta automáticamente en Edge Functions)
